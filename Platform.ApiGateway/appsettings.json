{
  "ReverseProxy": {
    "Routes": {
      "aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "Order": -1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Order": 10,
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Order": 10,
        "Match": { "Path": "/api/catalog/{**catch-all}" }
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Order": 10,
        "Match": { "Path": "/api/reviews/{**catch-all}" }
      }
    },
    "Clusters": {
      "aggregator-cluster": {
        "Destinations": { "aggregator": { "Address": "http://aggregator" } }
      },
      "orders-cluster": {
        "Destinations": { "orders": { "Address": "http://orders-api" } }
      },
      "catalog-cluster": {
        "Destinations": { "catalog": { "Address": "http://catalog-api" } }
      },
      "reviews-cluster": {
        "Destinations": { "reviews": { "Address": "http://reviews-api" } }
      }
    }
  },
  "AllowedHosts": "*"
}
